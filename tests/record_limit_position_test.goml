package tests;

use ecosystem::csv;
use std::testing;

#[test]
fn record_limit_positions_identify_the_excess_lf_across_terminator_modes() -> () {
    for terminator in[csv::Terminator::Any, csv::Terminator::CrLf, csv::Terminator::Byte(b'\n')] {
        for width in[1, 8] {
            let reader = ok(
                csv::Reader::new(
                    chunks("a,b\r\nnext,row\r\n", width),
                    csv::ReadOptions {
                        terminator,
                        buffer_size: width,
                        limits: csv::Limits { max_record_bytes: 4, ..csv::Limits::new() },
                        ..csv::ReadOptions::new(),
                    },
                ),
            );
            let failure = kind(reader.next_bytes(), csv::ErrorKind::Limit);
            testing::assert_eq(
                failure.position,
                csv::Position { byte: 4, record: 1, line: 2, column: 1 },
            );
            testing::assert(failure.field == Option::Some(1));
            testing::assert_eq(
                kind(reader.next_bytes(), csv::ErrorKind::Limit).position,
                failure.position,
            );
        }
    }
}

#[test]
fn crlf_limit_positions_preserve_bom_multiline_and_record_context() -> () {
    for (source, limit, offset, line) in[
        ("\uFEFFa\r\n", 2, 5, 2),
        ("\"a\r\nb\"\r\n", 7, 7, 3),
        ("\r\n", 1, 1, 2),
    ] {
        let input = chunks(source + "unread", 1);
        let reader = ok(
            csv::Reader::new(
                input,
                csv::ReadOptions {
                    buffer_size: 1,
                    skip_blank: true,
                    limits: csv::Limits { max_record_bytes: limit, ..csv::Limits::new() },
                    ..csv::ReadOptions::new(),
                },
            ),
        );
        let failure = kind(reader.next_bytes(), csv::ErrorKind::Limit);
        testing::assert_eq(
            failure.position,
            csv::Position { byte: offset, record: 1, line, column: 1 },
        );
        testing::assert_eq(input.offset.get(), offset + 1);
        let calls = input.calls.get();
        testing::assert_eq(
            kind(reader.next_bytes(), csv::ErrorKind::Limit).position,
            failure.position,
        );
        testing::assert_eq(input.calls.get(), calls);
    }
    let reader = ok(
        csv::Reader::new(
            chunks("x\r\na,b\r\n", 1),
            csv::ReadOptions {
                flexible: true,
                limits: csv::Limits { max_record_bytes: 4, ..csv::Limits::new() },
                ..csv::ReadOptions::new(),
            },
        ),
    );
    let _ = one(reader);
    testing::assert_eq(
        kind(reader.next(), csv::ErrorKind::Limit).position,
        csv::Position { byte: 7, record: 2, line: 3, column: 1 },
    );
}
